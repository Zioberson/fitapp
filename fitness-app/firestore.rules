rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Default Security: Deny all access unless explicitly allowed ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Users Collection ---
    // Users can read and update their own profile.
    // Trainers can read the profiles of their clients.
    match /users/{userId} {
      allow read, update: if request.auth.uid == userId;
      allow read: if exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'trainer' &&
                   resource.data.trainerId == request.auth.uid;
    }

    // --- TrainingPlans & MealPlans Collections ---
    // Trainers can create, read, update, and delete their own plans.
    // Clients can read plans assigned to them (via assignedPlans collection).
    match /trainingPlans/{planId} {
      allow read, write: if request.auth.uid == resource.data.trainerId;
    }

    match /mealPlans/{planId} {
        allow read, write: if request.auth.uid == resource.data.trainerId;
    }

    // --- AssignedPlans Collection ---
    // Trainers can assign/unassign plans to their clients.
    // Clients can read their own plan assignments.
    match /assignedPlans/{assignmentId} {
        allow read, create: if request.auth.uid == request.resource.data.trainerId;
        allow read: if request.auth.uid == resource.data.clientId;
        allow update: if request.auth.uid == resource.data.trainerId; // To deactivate plans
    }

    // --- Measurements Collection ---
    // Clients can create and read their own measurements.
    // The client's trainer can read their measurements.
    match /measurements/{measurementId} {
      allow create, read: if request.auth.uid == request.resource.data.clientId;
      allow read: if exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'trainer' &&
                   get(/databases/$(database)/documents/users/$(resource.data.clientId)).data.trainerId == request.auth.uid;
    }

    // --- Comments Collection ---
    // Authenticated users can create comments.
    // Users can read comments on targets they have access to (e.g., their own progress hub).
    // This is a simplified rule; for production, you might want more granular control based on targetType.
    match /comments/{commentId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null; // Allow any logged-in user to read comments for simplicity.
                                           // For stricter rules, check if user has access to the targetId.
    }

    // --- Notifications Collection ---
    // Users can only read their own notifications.
    // Notifications are created by a trusted server/function, but for client-side creation:
    // a user can create a notification for another user (e.g., trainer notifying client).
    match /notifications/{notificationId} {
        allow read: if request.auth.uid == resource.data.userId;
        allow create: if request.auth != null; // Allow any logged-in user to create notifications.
                                               // Stricter rule: ensure creator is allowed to notify the recipient.
    }
  }
}